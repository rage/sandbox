{
  "name": "modernized-sandbox",
  "version": "0.1.0",
  "packageManager": "pnpm@11.0.9",
  "type": "module",
  "scripts": {
    "dev": "tsgo run src/index.ts",
    "build": "tsgo",
    "start": "tsgo run dist/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "oxlint",
    "format": "oxfmt --write src/**/*.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/multipart": "10.0.0",
    "@fastify/sensible": "6.0.4",
    "@marcalexiei/fastify-type-provider-zod": "3.0.0",
    "fastify": "5.8.5",
    "tar-fs": "3.1.2",
    "zod": "4.4.3"
  },
  "lint-staged": {
    "*.ts": [
      "oxfmt --write",
      "oxlint"
    ]
  },
  "devDependencies": {
    "@types/node": "25.6.2",
    "@types/tar-fs": "^2.0.4",
    "@typescript/native-preview": "7.0.0-dev.20260511.1",
    "form-data": "4.0.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  }
}
